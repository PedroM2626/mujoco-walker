ALGO=sac
RUN_ID=walker_train
SEED=1
CHECKPOINT_INTERVAL=1000000
TOTAL_TIMESTEPS=1000000
LEARNING_RATE=3e-4
NUM_ENVS=32
BUFFER_SIZE=1000000
BATCH_SIZE=512
LEARNING_STARTS=10000
GAMMA=0.99
TAU=0.005
POLICY_FREQUENCY=2
TARGET_NETWORK_FREQUENCY=1
ALPHA=0.2
RESET_MODE=mixed
FIXED_RESET_PROBABILITY=0.25
UPRIGHT_RESET_PROBABILITY=0.15
FALLEN_VELOCITY_SCALE=0.35
TASK_PHASE=recovery
TARGET_FORWARD_VELOCITY=0.8
INIT_FROM_RUN_ID=
INIT_FROM_CHECKPOINT_STEP=
SAVE_REPLAY_BUFFER=true
# auto = parallel from NUM_ENVS >= VEC_PARALLEL_THRESHOLD envs, else sync.
VEC_BACKEND=auto
VEC_PARALLEL_THRESHOLD=16
MLFLOW_EXPERIMENT=walker-ragdoll
# MLFLOW_TRACKING_URI=http://localhost:5000
